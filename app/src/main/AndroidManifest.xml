<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Exact alarms for prayer times -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Location for prayer times calculation & Qibla direction -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground Service & Media Playback for Quran Audio -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:name=".NoorMuslimApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notifications.PrayerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.PrayerBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".audio.QuranAudioService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Widget Configuration Activity -->
        <activity
            android:name=".widgets.WidgetConfigureActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Widget Action Receiver -->
        <receiver
            android:name=".widgets.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.widgets.ACTION_TASBEEH_INCREMENT" />
                <action android:name="com.example.widgets.ACTION_TASBEEH_RESET" />
                <action android:name="com.example.widgets.ACTION_PLAYER_TOGGLE" />
                <action android:name="com.example.widgets.ACTION_REFRESH" />
                <action android:name="com.example.widgets.ACTION_OPEN_DESTINATION" />
            </intent-filter>
        </receiver>

        <!-- Curated 15 Distinct App Widgets (Phase 8 Clean Architecture) -->
        <!-- 1. Prayer Family -->
        <receiver
            android:name=".widgets.NextPrayerWidgetProvider"
            android:label="@string/widget_name_next_prayer"
            android:description="@string/widget_desc_next_prayer"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_prayer_next_info" />
        </receiver>

        <receiver
            android:name=".widgets.PrayerTimesDailyWidgetProvider"
            android:label="@string/widget_name_prayer_daily"
            android:description="@string/widget_desc_prayer_daily"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_prayer_daily_info" />
        </receiver>

        <receiver
            android:name=".widgets.PrayerMiniWidgetProvider"
            android:label="@string/widget_name_prayer_mini"
            android:description="@string/widget_desc_prayer_mini"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_prayer_mini_info" />
        </receiver>

        <receiver
            android:name=".widgets.PrayerPairWidgetProvider"
            android:label="@string/widget_name_prayer_pair"
            android:description="@string/widget_desc_prayer_pair"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_prayer_pair_info" />
        </receiver>

        <receiver
            android:name=".widgets.RamadanPrayerWidgetProvider"
            android:label="@string/widget_name_ramadan_prayer"
            android:description="@string/widget_desc_ramadan_prayer"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ramadan_prayer_info" />
        </receiver>

        <!-- 2. Quran Family -->
        <receiver
            android:name=".widgets.AyahOfTheDayWidgetProvider"
            android:label="@string/widget_name_ayah_of_day"
            android:description="@string/widget_desc_ayah_of_day"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quran_ayah_info" />
        </receiver>

        <receiver
            android:name=".widgets.LastReadingWidgetProvider"
            android:label="@string/widget_name_last_reading"
            android:description="@string/widget_desc_last_reading"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quran_last_read_info" />
        </receiver>

        <receiver
            android:name=".widgets.QuranProgressWidgetProvider"
            android:label="@string/widget_name_quran_progress"
            android:description="@string/widget_desc_quran_progress"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quran_khatmah_info" />
        </receiver>

        <receiver
            android:name=".widgets.QuranPlayerWidgetProvider"
            android:label="@string/widget_name_quran_player"
            android:description="@string/widget_desc_quran_player"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quran_player_info" />
        </receiver>

        <!-- 3. Adhkar Family -->
        <receiver
            android:name=".widgets.DailyDhikrWidgetProvider"
            android:label="@string/widget_name_daily_dhikr"
            android:description="@string/widget_desc_daily_dhikr"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_adhkar_card_info" />
        </receiver>

        <receiver
            android:name=".widgets.TasbeehCounterWidgetProvider"
            android:label="@string/widget_name_tasbeeh"
            android:description="@string/widget_desc_tasbeeh"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_adhkar_tasbeeh_info" />
        </receiver>

        <!-- 4. Utilities & Essentials Family -->
        <receiver
            android:name=".widgets.QiblaWidgetProvider"
            android:label="@string/widget_name_qibla"
            android:description="@string/widget_desc_qibla"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_qibla_info" />
        </receiver>

        <receiver
            android:name=".widgets.HijriDateWidgetProvider"
            android:label="@string/widget_name_hijri_date"
            android:description="@string/widget_desc_hijri_date"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_date_hijri_info" />
        </receiver>

        <receiver
            android:name=".widgets.DailyWorshipPlanWidgetProvider"
            android:label="@string/widget_name_worship_plan"
            android:description="@string/widget_desc_worship_plan"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_summary_info" />
        </receiver>

        <receiver
            android:name=".widgets.QuickShortcutsWidgetProvider"
            android:label="@string/widget_name_quick_shortcuts"
            android:description="@string/widget_desc_quick_shortcuts"
            android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_shortcuts_info" />
        </receiver>

    </application>

</manifest>
